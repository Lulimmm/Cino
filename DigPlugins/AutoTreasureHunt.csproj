<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>AutoTreasureHunt</AssemblyName>
    <RootNamespace>AutoTreasureHunt</RootNamespace>
    <Version>1.0.8.0</Version>
    <AssemblyVersion>1.0.8.0</AssemblyVersion>
    <FileVersion>1.0.8.0</FileVersion>
    <InformationalVersion>1.0.8.0</InformationalVersion>
    <AssemblyTitle>海豹助手</AssemblyTitle>
    <Product>海豹助手</Product>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">C:\Users\admin\.nuget\packages\aeassist.net\1.2.15\lib\net10.0</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)\Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)\Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudLibPath)\FFXIVClientStructs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InteropGenerator.Runtime">
      <HintPath>$(DalamudLibPath)\InteropGenerator.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudLibPath)\Lumina.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudLibPath)\Lumina.Excel.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Ignore local decompiler scratch output if it exists beside the project. -->
    <Compile Remove="tmp_decompile\**\*.cs" />
    <Compile Remove="tmp_decoder\**\*.cs" />
    <None Include="AutoTreasureHunt.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\dny.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\pixel-seal-idle.gif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\pixel-seal-hu.gif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\pixel-seal-happy.gif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\pixel-seal-happy-2.gif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\pixel-seal-jump.gif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\pixel-seal-jump-2.gif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\pixel-seal-fly.gif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\pixel-seal-cool.gif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\pixel-seal-cute.gif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\UranusCN.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\Pixelcraft.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\site-background.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\site-background-clean.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\FleetSnowfluff\now-playing-cover.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

